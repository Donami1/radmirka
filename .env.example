# Токен бота от @BotFather (обязательно)
BOT_TOKEN=1234567890:AAAA-your-token-here

# ID канала/чата для логов наказаний (необязательно, 0 = выключено).
# Бот должен быть админом этого канала. Пример: -1001234567890
LOG_CHANNEL_ID=0

# Глобальные админы бота через запятую (Telegram user id, необязательно)
ADMINS=

# ID разработчика — выше всех: полный доступ во всех чатах без выдачи роли,
# его нельзя наказать (можно несколько через запятую)
DEVELOPER_ID=

# Лимит варнов до авто-наказания (мут 24ч, повторно — бан)
WARN_LIMIT=3
